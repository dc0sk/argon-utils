#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

VENDOR_UPS_UNITS="argononeupsd.service argonupsrtcd.service"
# Deliberately NOT under /var/lib/argon-utils: the unit used to declare
# StateDirectory=argon-utils, which makes systemd chown that directory to the daemon -- and
# root acts on this file at package removal, so the daemon must not be able to write it.
RECORD=/var/lib/argon-utils-retired/units

# The vendor's units belong to no package: its installer is a curl-to-shell script that
# writes into /etc/argon. deb-systemd-invoke and deb-systemd-helper maintain dpkg's own
# enablement state for units a package ships, so they are the wrong tools here -- and
# deb-systemd-invoke consults policy-rc.d, which in a chroot or container would refuse the
# stop while `systemctl disable` still succeeded, leaving a second reader on the UPS serial
# port while recorded as retired. So: plain systemctl, for foreign units only.
foreign_systemctl() {
    systemctl "$@" >/dev/null 2>&1 || true
}

case "$1" in
configure)
    # --- the service account ---------------------------------------------------------
    # A system user with no home and no login: the daemon's device access comes from the
    # supplementary groups named in argond.service, and it needs nothing else.
    if ! getent passwd argon >/dev/null; then
        adduser --system --group --home /nonexistent --no-create-home \
            --shell /usr/sbin/nologin --quiet argon
    fi

    # The bus daemon reloads its policy the moment dpkg unpacks
    # /usr/share/dbus-1/system.d/org.argonutils.Daemon1.conf -- on a first install, before the
    # user above existed. It then drops the rule naming "argon" ("Unknown username") and argond,
    # started below, is refused its bus name until something else triggers a reload. Seen on
    # a fresh install on the ONE UP, 2026-09-19. So reload once the user exists. ReloadConfig
    # answers when the reload is done; busctl comes with systemd, which the package depends on.
    if [ -d /run/systemd/system ]; then
        busctl call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus \
            ReloadConfig >/dev/null 2>&1 || true
    fi

    # The unit names i2c, gpio and dialout as supplementary groups. systemd refuses to
    # start a service whose supplementary group does not exist, and the failure message
    # does not explain why, so say it here where it can be understood.
    missing=
    for g in i2c gpio dialout; do
        getent group "$g" >/dev/null || missing="$missing $g"
    done
    if [ -n "$missing" ]; then
        echo "argon-utils: WARNING: these groups do not exist on this system:$missing" >&2
        echo "argon-utils: argond will fail to start until they exist, or until you edit" >&2
        echo "argon-utils: SupplementaryGroups= in /usr/lib/systemd/system/argond.service." >&2
    fi

    # --- retire the vendor's UPS daemons ---------------------------------------------
    # Not a dpkg Conflicts, because the vendor stack is not a dpkg package: it is installed
    # by a curl-to-shell script into /etc/argon. So it is handled here instead.
    #
    # This is necessary rather than tidy-minded: two readers on one CDC-ACM port split the
    # byte stream and both desynchronise mid-frame, silently. What is disabled is recorded
    # so removal can put back exactly what was there, not a guess.
    if [ ! -d /run/systemd/system ]; then
        echo "argon-utils: systemd is not running; skipping vendor unit retirement." >&2
        echo "argon-utils: run 'dpkg-reconfigure argon-utils' on the real system." >&2
    else
        mkdir -p "$(dirname "$RECORD")"
        for u in $VENDOR_UPS_UNITS; do
            systemctl list-unit-files "$u" >/dev/null 2>&1 || continue
            state="$(systemctl is-enabled "$u" 2>/dev/null || true)"
            active="$(systemctl is-active "$u" 2>/dev/null || true)"

            # Record the FIRST state ever seen, so an upgrade cannot overwrite the original
            # with the disabled/inactive state this script itself produced.
            if ! grep -q "^$u " "$RECORD" 2>/dev/null; then
                printf '%s %s %s\n' "$u" "${state:-unknown}" "${active:-unknown}" >> "$RECORD"
            fi

            # Enforced on EVERY configure, not only the first. The operator may have
            # re-enabled it, or re-run the vendor's installer, and an upgrade is the one path
            # nobody watches -- two readers on the port desynchronise silently.
            if [ "$state" = enabled ] || [ "$active" = active ]; then
                echo "argon-utils: disabling $u (was ${state:-unknown}/${active:-unknown});" \
                     "it cannot share the UPS serial port with argond"
                foreign_systemctl stop "$u"
                foreign_systemctl disable "$u"
            fi
        done
    fi

    # --- udev ---------------------------------------------------------------------------
    # Reloaded here, after the argon group exists: the rules use GROUP="argon", and a rule
    # naming a group that does not exist yet leaves the device owned by root.
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload >/dev/null 2>&1 || true
        # --settle, because the daemon is started a few milliseconds later by the
        # dh_installsystemd snippet below: without waiting, its first open can hit EACCES on a
        # node that is still root:dialout.
        udevadm trigger --settle --subsystem-match=tty --subsystem-match=hidraw \
            >/dev/null 2>&1 || true
    fi

    # --- what the operator still has to decide ----------------------------------------
    mode="$(sed -n 's/^mode *= *"\(.*\)"/\1/p' /etc/argon-utils/config.toml 2>/dev/null | head -1)"
    if [ "$mode" = "read-only" ]; then
        echo "argon-utils: installed in read-only mode: it monitors and publishes status,"
        echo "argon-utils: and logs what it would do, but changes nothing and will NOT power"
        echo "argon-utils: the machine off on a critical battery."
        echo "argon-utils: to arm that, set mode = \"full\" in /etc/argon-utils/config.toml"
        echo "argon-utils: and run: systemctl restart argond"
    fi
    ;;

abort-upgrade|abort-remove|abort-deconfigure) ;;

*)
    echo "postinst called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

#DEBHELPER#

# The generated snippet above starts the service with `|| true` and prints nothing, so a
# service that never came up would leave no trace in the install output.
if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
    if ! systemctl is-active --quiet argond.service; then
        echo "argon-utils: argond is not running. See: systemctl status argond" >&2
        echo "argon-utils: (this is expected if /etc/argon-utils/disabled exists)" >&2
    fi
fi

exit 0
