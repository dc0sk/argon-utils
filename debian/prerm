#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

case "$1" in
remove)
    # A ONE UP taken over with oneup-takeover is handed back before the package goes, while
    # oneup-restore still exists: otherwise removal would leave argononeupd disabled and
    # nothing at all watching the battery. Not on upgrade -- the takeover carries over.
    if [ -f /var/lib/argon-utils/oneup-takeover ] && [ -x /usr/libexec/argon-utils/oneup-restore ]; then
        echo "argon-utils: handing the ONE UP back to argononeupd (oneup-restore); reboot afterwards." >&2
        /usr/libexec/argon-utils/oneup-restore >&2 ||
            echo "argon-utils: WARNING: oneup-restore failed; argononeupd may still be disabled." >&2
    fi
    ;;
esac

#DEBHELPER#

exit 0
