#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

RECORD=/var/lib/argon-utils-retired/units

#DEBHELPER#

case "$1" in
remove|purge)
    # A poweroff argond scheduled outlives argond on purpose: a critical battery does not
    # stop being critical because the daemon stopped. Removing the package is exactly when
    # nobody is watching for it, so say so loudly rather than cancelling it silently --
    # cancelling on the operator's behalf could be the thing that powers off a machine with
    # an empty battery and no clean shutdown.
    pending="$(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
        org.freedesktop.login1.Manager ScheduledShutdown 2>/dev/null || true)"
    case "$pending" in
    *poweroff*)
        echo "argon-utils: WARNING: a poweroff is still scheduled: $pending" >&2
        echo "argon-utils: cancel it with 'shutdown -c' if that is not what you want." >&2
        ;;
    esac

    # Put the vendor's UPS daemons back the way they were found at install time. A unit that
    # was already disabled before argon-utils arrived stays disabled.
    if [ -f "$RECORD" ]; then
        while read -r unit state active; do
            [ -n "${unit:-}" ] || continue
            # Only ever the units this package retires. The record is a file on disk, and a
            # root script must not start whatever it happens to contain.
            case "$unit" in
            argononeupsd.service | argonupsrtcd.service) ;;
            *)
                echo "argon-utils: ignoring unexpected unit in $RECORD: $unit" >&2
                continue
                ;;
            esac
            # `disable` was used, not `mask`, so `enable` is the exact inverse.
            if [ "$state" = enabled ]; then
                systemctl enable "$unit" >/dev/null 2>&1 || true
            fi
            if [ "$active" = active ]; then
                echo "argon-utils: restoring $unit"
                systemctl start "$unit" >/dev/null 2>&1 || true
            fi
        done < "$RECORD"
        rm -f "$RECORD"
    fi

    rm -rf /run/argon-utils
    rmdir /var/lib/argon-utils-retired 2>/dev/null || true

    # Undo the udev rules' effect now rather than at the next reboot: without this,
    # /dev/ttyACM0 keeps GROUP="argon" and the /dev/argon-* symlinks persist -- and after a
    # purge that group no longer exists, leaving a numeric gid nobody is in.
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload >/dev/null 2>&1 || true
        udevadm trigger --subsystem-match=tty --subsystem-match=hidraw >/dev/null 2>&1 || true
    fi
    ;;
esac

case "$1" in
purge)
    # dpkg removes the conffiles themselves (config.toml and the autostart entry); only the
    # directory and the kill-switch file are ours to clean up.
    rm -f /etc/argon-utils/disabled
    rmdir /etc/argon-utils 2>/dev/null || true
    # The drift record. Kept on remove -- it is history nothing else holds -- and gone on purge.
    rm -rf /var/lib/argon-utils
    if getent passwd argon >/dev/null; then
        deluser --system --quiet argon >/dev/null 2>&1 || true
    fi
    if getent group argon >/dev/null; then
        delgroup --system --quiet argon >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
