# SPDX-License-Identifier: GPL-3.0-or-later
[Unit]
Description=Argon40 UPS, OLED and fan daemon
Documentation=https://github.com/dc0sk/argon-utils

# Let systemd enforce mutual exclusion for the UPS: two readers on one CDC-ACM port split the
# byte stream and both desynchronise, and argononeupsd runs its own shutdown logic besides.
#
# argononed (the vendor's FAN daemon) is deliberately NOT listed. Conflicts= on a unit we do
# not own and will not restore is a one-way door: on a Pi 4-era case, installing this package
# would stop the vendor's fan daemon as a side effect of starting, with nothing recorded and
# nothing to put it back -- and in the shipped read-only mode argond would not drive the fan
# either, leaving it at whatever duty was last written. MCU contention is handled at runtime
# instead, by degrading to read-only (see startup::decide).
Conflicts=argononeupsd.service argonupsrtcd.service argononeupd.service

# The poweroff path goes through logind over the system bus, under polkit. Without this
# ordering the contention and shutdown checks can run before the bus is there.
After=local-fs.target dbus.service systemd-logind.service
Wants=dbus.service

# A kill switch that does not require editing TOML from a rescue shell: if the daemon ever
# misbehaves at boot, `touch /etc/argon-utils/disabled` keeps it from starting.
ConditionPathExists=!/etc/argon-utils/disabled

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/argond

# The backstop for SIGKILL, where no in-process mechanism can help because the process has
# stopped executing. The daemon's signal handler and Drop guard cover every other case.
# `-` so a failure here does not mask the real stop reason.
ExecStopPost=-/usr/bin/argonctl fan --safe
# Blank the case OLED if argond was drawing on it. argond does this itself on a clean stop;
# this covers SIGKILL, where a status page left on the panel would go on claiming whatever it
# last said. --if-enabled makes it a no-op on a machine that does not use the display.
ExecStopPost=-/usr/bin/argonctl oled --off --if-enabled

Restart=always
RestartSec=2

# Fed from the control loop itself, not a timer thread: a watchdog pinged by a thread that
# is not doing the work will happily keep a wedged control loop alive.
WatchdogSec=30

# The daemon does not need root. Device access comes from group membership, and host power
# actions go through logind over D-Bus under polkit -- which needs
# packaging/polkit/50-argon-utils.rules, because a process outside a login session is
# otherwise asked for administrator authentication it cannot give.
User=argon
Group=argon
SupplementaryGroups=i2c gpio dialout

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# PrivateDevices would hide the very devices this exists to drive, so it stays off and the
# allow-list below is the narrowing instead.
PrivateDevices=no
DeviceAllow=char-i2c rw
DeviceAllow=char-ttyACM rw
DeviceAllow=char-hidraw rw

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# No StateDirectory=: nothing here keeps state across boots, and systemd would recursively
# chown the directory to the daemon -- which is where the package's own rollback record lives,
# so the daemon would end up owning a file that root acts on at removal time.
#
# RuntimeDirectoryPreserve=restart so a restart does not delete the published status file: the
# desktop agent would otherwise lose a pending poweroff across a package upgrade.
RuntimeDirectory=argon-utils
RuntimeDirectoryPreserve=restart
ConfigurationDirectory=argon-utils

[Install]
WantedBy=multi-user.target
